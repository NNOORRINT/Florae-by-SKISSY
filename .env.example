# Copy this file to .env (never commit .env). On Vercel, add the same variables under
# Project → Settings → Environment Variables.

# Claude API key, used by server.js for photo checks: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---- Plant wiki import (scripts/import-wiki.mjs), run from your own machine ----
# Supabase → Project Settings → API Keys → secret key (starts with sb_secret_).
# Server-side only: never put it in public/ or in the browser.
SUPABASE_SERVICE_KEY=
# Optional: defaults to the project in public/config.js
# SUPABASE_URL=https://your-project.supabase.co

# Wikimedia asks every script to identify itself with a way to contact you.
WIKI_USER_AGENT="FloraeWiki/1.0 (https://your-site.example; you@your-domain.example)"

# Optional: free token from https://trefle.io/profile (adds habitat indicators,
# temperature and sowing data). Leave empty to skip Trefle.
TREFLE_TOKEN=
